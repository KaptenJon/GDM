<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <OutputType>WinExe</OutputType>
    <RootNamespace>GDMService</RootNamespace>
    <AssemblyName>GDMService</AssemblyName>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <Platforms>AnyCPU</Platforms>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <NoWarn>$(NoWarn);WFO1000</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.3" />
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="10.0.3" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\GDMCore\GDMCore.csproj" />
    <!-- Build dependency only � GDMPlugins is loaded dynamically at runtime -->
    <ProjectReference Include="..\GDMPlugins\GDMPlugins.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <!-- Copy GDMPlugins build output (and all its dependencies) to the Plugin subfolder -->
  <Target Name="CopyPluginsToOutput" AfterTargets="Build;Rebuild">
    <ItemGroup>
      <PluginFiles Include="..\GDMPlugins\bin\$(Configuration)\$(TargetFramework)\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(PluginFiles)" DestinationFolder="$(OutputPath)Plugin\" SkipUnchangedFiles="false" />
  </Target>
</Project>
