<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <OutputType>WinExe</OutputType>
    <RootNamespace>GDMTool</RootNamespace>
    <AssemblyName>GDMTool</AssemblyName>
    <ApplicationIcon>Images\Logo-GDM_256x256pxl.ico</ApplicationIcon>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <Platforms>AnyCPU;x86</Platforms>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="MathNet.Numerics.Signed" Version="5.0.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\GDMCore\GDMCore.csproj" />
    <ProjectReference Include="..\GDMInterfaces\GDMInterfaces.csproj" />
    <!-- Build dependency only — GDMPlugins is loaded dynamically at runtime -->
    <ProjectReference Include="..\GDMPlugins\GDMPlugins.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Images\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- Copy GDMPlugins build output (and all its dependencies) to the Plugin subfolder -->
  <Target Name="CopyPluginsToOutput" AfterTargets="Build;Rebuild">
    <ItemGroup>
      <PluginFiles Include="..\GDMPlugins\bin\$(Configuration)\$(TargetFramework)\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(PluginFiles)" DestinationFolder="$(OutputPath)Plugin\" SkipUnchangedFiles="false" />
  </Target>
</Project>
